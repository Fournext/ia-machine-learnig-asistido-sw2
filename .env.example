# Configuración general
APP_NAME="Gym Churn Prediction Engine"
APP_VERSION="1.0.0"
ENVIRONMENT="production"

# Artefactos de Machine Learning (Sistema de Archivos)
MODEL_ARTIFACTS_DIR="artifacts/models"
ACTIVE_MODEL_VERSION="1.0.0"

# Umbrales de clasificación de riesgo
UMBRAL_RIESGO_BAJO_MAX=0.30
UMBRAL_RIESGO_MEDIO_MAX=0.70

# Seguridad JWT
JWT_SECRET_KEY="cambiar-en-produccion-por-un-secreto-seguro"
JWT_ALGORITHM="HS256"

# Microservicios externos del ERP
ERP_GATEWAY_URL="http://gateway:8000/api"
USERS_SERVICE_URL="http://users-service:8001/api/v1/users"
MEMBERSHIPS_SERVICE_URL="http://memberships-service:8002/api/v1/memberships"
ATTENDANCES_SERVICE_URL="http://attendances-service:8003/api/v1/attendances"
